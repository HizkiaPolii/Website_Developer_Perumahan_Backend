# Database
# Lokal:    postgresql://user:password@localhost:5432/perumahan_db
# Produksi: connection string dari Neon (wajib diakhiri ?sslmode=require)
DATABASE_URL="postgresql://user:password@localhost:5432/perumahan_db"

# Server
# Di Railway, PORT diisi otomatis oleh platform — tidak perlu diset manual.
PORT=5000
NODE_ENV="development"

# CORS
# Daftar origin yang diizinkan, dipisahkan koma tanpa garis miring di akhir.
# Produksi contoh: https://namaaplikasi.vercel.app
FRONTEND_URL="http://localhost:3000"

# Autentikasi
# JWT_SECRET harus acak dan panjang. Jangan pakai nilai yang sama dengan lokal.
# Bangkitkan dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="ganti-dengan-nilai-acak-yang-panjang"
JWT_EXPIRE="7d"
